	<logic>
		<connect governor="res_data.available" client="res_vs.root" />
		<convert id="cond_vfold" sources="res_type.string" mode="equals" standard="vfold" />
		<convert id="cond_boot" sources="res_type.string" mode="equals" standard="boot" />
		<convert id="cond_split" sources="res_type.string" mode="equals" standard="split" />
		<connect governor="cond_vfold" client="frm_kfold.enabled" />
		<connect governor="cond_boot" client="frm_boot.enabled" />
		<connect governor="cond_split" client="frm_split.enabled" />
		<connect governor="res_seed_chk.state" client="res_seed_val.enabled" />
	</logic>
	<dialog label="1. Resample Data (Validation Strategy)">
		<row id="row_vDMDMDRSVO">
			<varselector id="res_vs" />
			<column id="clm_tDMDMDRSVO">
				<tabbook>
					<tab label="Data &amp; Method" id="tab_DataMthd">
						<column id="clm_vDRSVORMKF">
							<varslot id="res_data" label="Dataset to Resample" source="res_vs" classes="data.frame" required="true" />
							<varslot id="res_strata" label="Stratification Variable (Optional but recommended to balance classes)" source="res_vs" />
							<dropdown id="res_type" label="Resampling Method">
								<option label="K-Fold Cross-Validation" value="vfold" checked="true" />
								<option label="Bootstrap Resampling" value="boot" />
