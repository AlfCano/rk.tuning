msgid "1. Inputs & Goal"
msgstr "1. Entrées et Objectif"

msgid "2. Plot Options"
msgstr "2. Options de Graphique"

msgid "3. Output"
msgstr "3. Sortie"

msgid "Main Title (Leave empty for default)"
msgstr "Titre Principal (Laisser vide pour utiliser par défaut)"

msgid "X-Axis Label (Leave empty for default)"
msgstr "Étiquette de l'Axe des X (Laisser vide pour utiliser par défaut)"

msgid "Y-Axis Label (Leave empty for default)"
msgstr "Étiquette de l'Axe des Y (Laisser vide pour utiliser par défaut)"

msgid "Plot Customization"
msgstr "Personnalisation du Graphique"

msgid "HTML Graphics Size"
msgstr "Taille des Graphiques HTML"

msgid "Export Objects to Workspace"
msgstr "Exporter les Objets vers l'Espace de Travail"
