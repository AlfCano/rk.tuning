msgid "1. Inputs & Goal"
msgstr "1. Entradas e Objetivo"

msgid "2. Plot Options"
msgstr "2. Opções de Gráfico"

msgid "3. Output"
msgstr "3. Saída"

msgid "Main Title (Leave empty for default)"
msgstr "Título Principal (Deixe vazio para usar o padrão)"

msgid "X-Axis Label (Leave empty for default)"
msgstr "Rótulo do Eixo X (Deixe vazio para usar o padrão)"

msgid "Y-Axis Label (Leave empty for default)"
msgstr "Rótulo do Eixo Y (Deixe vazio para usar o padrão)"

msgid "Plot Customization"
msgstr "Personalização do Gráfico"

msgid "HTML Graphics Size"
msgstr "Tamanho dos Gráficos HTML"

